@{
    var email = ViewBag.Emailid as string;
}
<h2>Basic Details</h2>
<form asp-controller="BasicDetails" asp-action="ValidateBasicDetails" method="post">
    <input type="hidden" name="EmailId" value="@email" />
    <div class="row">
        <div class="col-md-6 mb-3"><label>First Name</label><input name="FirstName" class="form-control" required /></div>
        <div class="col-md-6 mb-3"><label>Last Name</label><input name="LastName" class="form-control" /></div>
        <div class="col-md-6 mb-3"><label>Mobile Number</label><input name="MobileNumber" class="form-control" required /></div>
        <div class="col-md-6 mb-3"><label>PAN Number</label><input name="PanNumber" class="form-control" required /></div>
        <div class="col-md-6 mb-3"><label>Aadhar Number</label><input name="AadharNumber" class="form-control" required /></div>
        <div class="col-md-6 mb-3"><label>Pincode</label><input name="Pincode" type="number" class="form-control" required /></div>
        <div class="col-md-6 mb-3"><label>Date of Birth</label><input name="Dob" type="date" class="form-control" required /></div>
    </div>
    <button type="submit" class="btn btn-primary">Save & Continue</button>
</form>